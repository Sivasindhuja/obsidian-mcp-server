# Copy to .env and fill in the API key from Obsidian:
# Settings -> Local REST API -> API key.
OBSIDIAN_API_KEY=

# Obsidian Local REST API connection.
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PROTOCOL=https
OBSIDIAN_PORT=27124

# The plugin uses a self-signed certificate by default. For localhost this is
# normally left false. Set OBSIDIAN_CA_BUNDLE to trust a specific CA instead.
OBSIDIAN_VERIFY_SSL=false
# OBSIDIAN_CA_BUNDLE=/path/to/obsidian-local-rest-api.crt

# Optional operational settings. Invalid numbers fall back to defaults and
# out-of-range values are clamped to safe limits.
# OBSIDIAN_TIMEOUT=10
# OBSIDIAN_LOG_LEVEL=INFO
# OBSIDIAN_CIRCUIT_FAILURE_THRESHOLD=3
# OBSIDIAN_CIRCUIT_RECOVERY_TIME=10
# OBSIDIAN_STATS_CONCURRENCY=10
# OBSIDIAN_MAX_FILE_BYTES=1000000
# OBSIDIAN_MAX_BATCH_BYTES=2000000
# OBSIDIAN_MAX_SEARCH_BYTES=1000000
# OBSIDIAN_MAX_SUMMARY_BYTES=1000000
